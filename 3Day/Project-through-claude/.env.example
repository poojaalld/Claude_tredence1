# Claude (Anthropic) - required for generation
ANTHROPIC_API_KEY=

# Voyage AI - preferred embedding provider
VOYAGE_API_KEY=

# OpenAI - fallback embedding provider
OPENAI_API_KEY=

# Embedding provider: "voyage" or "openai"
EMBEDDING_PROVIDER=voyage

# Vector store backend: "faiss" or "pgvector"
VECTOR_STORE=faiss

# pgvector connection (only needed if VECTOR_STORE=pgvector)
PG_HOST=localhost
PG_PORT=5432
PG_DB=banking_rag
PG_USER=postgres
PG_PASSWORD=
