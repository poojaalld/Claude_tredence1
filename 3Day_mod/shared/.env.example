# Copy this file to shared/.env and fill in real values.
# shared/.env is gitignored -- never commit real API keys.

# --- LLM (Claude RAG generation, Part 7) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Embeddings (Part 4) ---
# EMBEDDING_PROVIDER selects which key/model below is used: "openai" or "voyage"
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3

# --- Chunking (Part 3) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
SEMANTIC_SIMILARITY_THRESHOLD=0.75

# --- Vector store (Part 5) ---
# VECTOR_STORE selects the index backend: "faiss" or "pgvector"
VECTOR_STORE=faiss
DATABASE_URL=postgresql://user:password@localhost:5432/banking_rag

# --- Retriever (Part 6) ---
TOP_K=5

# --- App servers (Part 8 / Part 9) ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
STREAMLIT_PORT=8501
# API_BASE_URL is where Part 9's Streamlit app reaches Part 8's API -- leave
# as-is for local dev; in Docker Compose (Part 10) this becomes the backend
# service's name, e.g. http://backend:8000
API_BASE_URL=http://localhost:8000
