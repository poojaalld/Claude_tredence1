# Overrides for application.yml (see the ${VAR:default} placeholders in that file).
# Copy to .env and adjust as needed; uncommitted values fall back to the defaults.

SERVER_PORT=8000

DB_URL=sqlite:///./digital_banking.db
DB_ECHO=false

JWT_SECRET=change-this-to-a-long-random-secret-in-every-environment
JWT_EXPIRATION_MINUTES=1440

LOAN_DEFAULT_INTEREST_RATE=10.5
LOAN_MAX_TENURE_MONTHS=360
LOAN_MIN_AMOUNT=10000
LOAN_MAX_AMOUNT=5000000

NOTIFICATION_CHANNEL=CONSOLE
